#!/usr/bin/env bash
# Offline install of litellm-gateway-hooks into the LiteLLM proxy's Python environment.
# Usage: ./install.sh [/path/to/python]   (default: python3)
set -euo pipefail

PY="${1:-python3}"
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! LITELLM_VERSION="$("$PY" -c 'import importlib.metadata as m; print(m.version("litellm"))' 2>/dev/null)"; then
  echo "error: litellm is not installed for $PY. Install litellm-gateway-hooks into the proxy's environment." >&2
  exit 1
fi
# Must match the litellm requirement in pyproject.toml; checked here so pip never gets to fail offline.
if ! "$PY" -c 'import re, sys; v = tuple(int(x) for x in re.findall(r"\d+", sys.argv[1])[:3]); sys.exit(not ((1, 108, 15) <= v < (1, 109)))' "$LITELLM_VERSION"; then
  echo "error: litellm-gateway-hooks @VERSION@ is built for litellm 1.108.15 or a later 1.108.x, found $LITELLM_VERSION" >&2
  exit 1
fi

"$PY" -m pip install --no-index --find-links "$DIR/wheelhouse" litellm-gateway-hooks==@VERSION@
"$PY" -c 'import gateway_hooks.gateway, gateway_hooks.limits.store; print("litellm-gateway-hooks installed for litellm", __import__("importlib.metadata").metadata.version("litellm"))'
